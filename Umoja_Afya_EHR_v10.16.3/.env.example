# Development profile. Production uses discrete UMOJA_DB_* values and Docker secrets.
UMOJA_ENVIRONMENT=development
DATABASE_URL=sqlite:///./umoja_afya.db
UMOJA_SECURITY_SECRET=development-secret-change-before-sharing
UMOJA_CORS_ORIGINS=http://localhost:8000
UMOJA_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
UMOJA_OFFLINE_ACCESS_ENABLED=true
UMOJA_OFFLINE_LEASE_HOURS=24
UMOJA_OFFLINE_MAX_PENDING=1000
# Optional local transcription service endpoint.
UMOJA_TRANSCRIPTION_ENDPOINT=
UMOJA_TRANSCRIPTION_REQUIRED=false
UMOJA_TRANSCRIPTION_MIN_CONFIDENCE=0.55
UMOJA_RETAIN_RAW_CLINICAL_AUDIO=false

# Allow up to 50 MB clinical audio plus multipart overhead.
UMOJA_MAX_REQUEST_BYTES=62914560

# Public deployment identity
UMOJA_PUBLIC_HOST=ehr.example.go.tz
UMOJA_CORS_ORIGINS=https://ehr.example.go.tz
UMOJA_ALLOWED_HOSTS=ehr.example.go.tz
TRAEFIK_NETWORK=traefik
TRAEFIK_CERTRESOLVER=letsencrypt
TZ=Africa/Dar_es_Salaam

# Database identifiers. Password is stored in secrets/postgres_password.
POSTGRES_DB=umoja_afya
POSTGRES_USER=umoja

# First administrator is created in the secure browser setup using secrets/bootstrap_token.

# Runtime tuning
WEB_CONCURRENCY=4
UMOJA_DB_POOL_SIZE=15
UMOJA_DB_MAX_OVERFLOW=30
UMOJA_RATE_LIMIT_PER_MINUTE=1200
UMOJA_LOGIN_RATE_LIMIT_PER_MINUTE=20
UMOJA_API_DOCS_ENABLED=false

# Installable offline workspace. Use a shorter lease for shared clinical devices.
UMOJA_OFFLINE_ACCESS_ENABLED=true
UMOJA_OFFLINE_LEASE_HOURS=24
UMOJA_OFFLINE_MAX_PENDING=1000

# Clinical audio transcription. large-v3 provides the strongest bundled accuracy but
# requires materially more CPU/RAM and model-download time. Use GPU settings where validated.
UMOJA_TRANSCRIPTION_REQUIRED=true
# "small" is the safe CPU-VPS default. Upgrade to medium/large-v3 only after
# confirming sufficient RAM, disk and startup time for the larger model.
UMOJA_WHISPER_MODEL=small
UMOJA_WHISPER_DEVICE=cpu
UMOJA_WHISPER_COMPUTE_TYPE=int8
UMOJA_WHISPER_CPU_THREADS=6
UMOJA_WHISPER_NUM_WORKERS=1
UMOJA_TRANSCRIPTION_TIMEOUT_SECONDS=300
UMOJA_MAX_REQUEST_BYTES=62914560
UMOJA_TRANSCRIPTION_MAX_AUDIO_BYTES=52428800
UMOJA_TRANSCRIPTION_MIN_CONFIDENCE=0.55
UMOJA_RETAIN_RAW_CLINICAL_AUDIO=false
UMOJA_WHISPER_EAGER_LOAD=true

# Facility payment channels. Configure institutional destinations only. Never
# store card PAN/CVV, mobile PINs, seed phrases or private keys here.
UMOJA_CASH_DRAWER_ID=MNH-UPANGA-MAIN
UMOJA_CARD_TERMINAL_ID=
UMOJA_MOBILE_MONEY_TILL=
UMOJA_BANK_ACCOUNT=
UMOJA_PAYMENT_GATEWAY_ACCOUNT=
UMOJA_CRYPTO_WALLET=
UMOJA_CRYPTO_NETWORK=

# Optional overrides for docker-compose.review.yml
UMOJA_BIND_ADDRESS=0.0.0.0
UMOJA_HTTP_PORT=8000
# Review transcription model. The first transcription downloads the selected model.
UMOJA_REVIEW_WHISPER_MODEL=small
UMOJA_WHISPER_DEVICE=cpu
UMOJA_WHISPER_COMPUTE_TYPE=int8
UMOJA_WHISPER_CPU_THREADS=4

# Allow up to 50 MB clinical audio plus multipart overhead.
UMOJA_MAX_REQUEST_BYTES=62914560
